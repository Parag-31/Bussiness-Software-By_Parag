# Copy this file to ".env" (same folder) and set your own values BEFORE
# the very first start of the app. The values below are only used the
# first time each login is created in the database — once an account
# exists, changing .env does not change its password.
#
# If you skip this file entirely, the app falls back to the same
# temporary passwords documented in README.md, exactly as before.

# Port the server listens on.
PORT=4000

# Temporary first-login passwords. Each user must choose their own new
# password on first sign-in (Vishwas/Parag) or should change it in
# Settings immediately (admin).
ADMIN_TEMP_PASSWORD=admin123
PARAG_TEMP_PASSWORD=Parag@2026
VISHWAS_TEMP_PASSWORD=Vishwas@2026

# Restricts which origins may call the API. Leave unset ("*") for normal
# local desktop use. Set to your real origin only if you ever expose this
# server beyond localhost (e.g. http://192.168.1.20:4000).
CORS_ORIGIN=*

# Optional: automatic cloud backup to Dropbox, on top of the local daily
# backup that already happens regardless. Leave both blank to skip this —
# nothing else changes.
#
# 1. Go to https://www.dropbox.com/developers/apps and create an app
#    (Scoped access, "App folder" access type is enough).
# 2. Under Permissions, enable files.content.write.
# 3. Under Settings, click "Generate access token" and paste it below.
# Every automatic daily backup, and the "Back up to Dropbox" button in
# Settings, will then also upload a copy to this Dropbox account.
DROPBOX_ACCESS_TOKEN=
DROPBOX_FOLDER=/Vishwa Infra Backups
